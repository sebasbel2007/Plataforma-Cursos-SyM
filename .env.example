# File: plataforma cursos SyM/.env.example
# Copiar este archivo como .env y completar con las credenciales reales
# NUNCA subir el archivo .env al repositorio

# ─── Firebase ───────────────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ─── Mercado Pago Sandbox ────────────────────────────────────
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ─── Cloudinary (borrado seguro de archivos) ───────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Firebase Admin (validación de tokens en el server) ────
# Ruta al JSON de service account (colocarlo en la raíz, NO subirlo al repo)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-adminsdk.json

# ─── Configuración de la plataforma ─────────────────────────
PLATFORM_NAME=Cursos SyM
PLATFORM_COMMISSION=0.30
TEACHER_MEMBERSHIP_PRICE_ARS=20000
